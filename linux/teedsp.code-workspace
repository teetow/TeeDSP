        "options": { "cwd": "${workspaceFolder:TeeDSP Linux}/.." },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": [],
        "presentation": {
          "panel": "shared", "reveal": "always", "clear": true,
          "close": false, "showReuseMessage": false
        }
      }
    ]
  }
}
