;
; TeeDspAirPodsExtension.inf
;
; Device-extension INF that binds the TeeDSP APO as the stream-effect (SFX) on
; the AirPods Pro A2DP render endpoint, driven by the inbox Microsoft Bluetooth
; A2DP source driver (microsoft_bluetooth_a2dp_src.inf / BthA2dpSrc). The inbox
; driver sets its own effects under "MSFX\N" and documents that third parties
; must use "FX\N"; keeping the inbox MFX untouched is essential (a second MFX
; works after a cold boot but makes the A2DP graph reject its own mix format
; after an AirPods reconnect). The APO itself is registered by the TeeDSP APO
; software component; this only binds it to this endpoint.
;
; v1.0.3 (installed 2026-07-03) removed the COMMUNICATIONS processing mode that
; v1.0.2 registered alongside DEFAULT, suspecting it broke endpoint reuse on
; Bluetooth reconnect (15 abandoned endpoint GUIDs 06-26..07-02). RE-LITIGATED
; 2026-07-07 against the Audio/Operational event log: that attribution is a
; CONFOUNDED ASSOCIATION, not an established cause. Churn continued after the
; removal (same PnP interface-teardown signature at connect time), the v1.0.2
; era reused GUIDs cleanly on ~57% of reconnects, and the v1.0.3 A/B coincided
; with a package cleanup, a fresh endpoint, and an APO component reinstall.
; The mint rate did drop ~4x, so DEFAULT-only stays (it is also sufficient —
; see below); if COMMS registration is ever needed again, gate it on the
; event-log metric (scripts\Get-AirPodsEndpointHistory.ps1) over matched
; windows.
;
; COMMS registration turned out to be unnecessary anyway: comms apps bypass
; the APO because they open RAW streams, not because of the mode list. With
; Zoom's "Windows system audio enhancements" set to On (confirmed 2026-07-07)
; the stream is non-RAW and falls back to DEFAULT mode, which this INF
; registers — Zoom playback is processed with DEFAULT only. The separate
; silent-reconnect wedge persists and is still under investigation (see
; WORKLOG).
;
; Target is the AirPods-specific hardware id (Apple VID 004C / PID 2024) so we
; do not blanket every A2DP headphone.

[Version]
Signature   = "$WINDOWS NT$"
Class       = Extension
ClassGuid   = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider    = %ProviderName%
ExtensionId = {2f9b6e11-4c3a-4e7d-9f21-a1b2c3d4e5f6}
DriverVer   = 07/03/2026,1.0.3.0
CatalogFile = TeeDspAirPods.cat
PnpLockDown = 1

[Manufacturer]
%MfgName% = TeeDspAirPods, NTamd64

[TeeDspAirPods.NTamd64]
%DeviceDesc% = TeeDspAirPods_Install, BTHENUM\{0000110b-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&2024

[TeeDspAirPods_Install]
; Extension adds only the endpoint effect below; no files/services.

[TeeDspAirPods_Install.Interfaces]
; Same audio category + reference string ("SRC") the base driver uses, so our
; AddReg merges into the existing render endpoint interface.
AddInterface = %KSCATEGORY_AUDIO%, %A2dpSrcRef%, TeeDspAirPods_AudioInterface

[TeeDspAirPods_AudioInterface]
AddReg = TeeDspAirPods_SysFx_AddReg
DelReg = TeeDspAirPods_RemoveOldMfx

; DEFAULT mode only (v1.0.2 also listed COMMUNICATIONS — see header). The
; multi-sz AddReg overwrites the v1.0.2 value on update, so no extra DelReg is
; needed for the mode list.
[TeeDspAirPods_SysFx_AddReg]
HKR,"FX\\0",%PKEY_ItemNameDisplay%,,%FX_FriendlyName%
HKR,"FX\\0",%PKEY_FX_StreamEffectClsid%,,%TEEDSP_SFX_CLSID%
HKR,"FX\\0\\%TeeDsp_Context%",%PKEY_FX_Association%,,%KSNODETYPE_ANY%
HKR,"FX\\0\\%TeeDsp_Context%\\User",,,
HKR,"FX\\0",%PKEY_SFX_ProcessingModes_Supported_For_Streaming%,%FLG_ADDREG_TYPE_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%

; Upgrade cleanup: v1.0.0.0 installed TeeDSP as an MFX.  Remove its two
; properties explicitly so updating the extension cannot leave both bindings
; active on an already-paired AirPods device.
[TeeDspAirPods_RemoveOldMfx]
HKR,"FX\\0",%PKEY_FX_ModeEffectClsid%
HKR,"FX\\0",%PKEY_MFX_ProcessingModes_Supported_For_Streaming%

[Strings]
ProviderName = "TeeDSP"
MfgName      = "TeeDSP"
DeviceDesc   = "AirPods Pro (TeeDSP stream effect)"

KSCATEGORY_AUDIO = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
A2dpSrcRef       = "SRC"
TeeDsp_Context   = "{B7E1A0C0-7E5D-4D8B-9E2A-1C4F8D3A2B11}"

PKEY_ItemNameDisplay                            = "{B725F130-47EF-101A-A5F1-02608C9EEBAC},10"
PKEY_FX_Association                             = "{D04E05A6-594B-4fb6-A80D-01AF5EED7D1D},0"
PKEY_FX_StreamEffectClsid                       = "{D04E05A6-594B-4fb6-A80D-01AF5EED7D1D},5"
PKEY_FX_ModeEffectClsid                         = "{D04E05A6-594B-4fb6-A80D-01AF5EED7D1D},6"
PKEY_SFX_ProcessingModes_Supported_For_Streaming = "{D3993A3F-99C2-4402-B5EC-A92A0367664B},5"
PKEY_MFX_ProcessingModes_Supported_For_Streaming = "{D3993A3F-99C2-4402-B5EC-A92A0367664B},6"

KSNODETYPE_ANY                     = "{00000000-0000-0000-0000-000000000000}"
AUDIO_SIGNALPROCESSINGMODE_DEFAULT = "{C18E2F7E-933D-4965-B7D1-1EEF228D2AF3}"
TEEDSP_SFX_CLSID                   = "{B7E1A0C0-7E5D-4D8B-9E2A-1C4F8D3A2B11}"
FX_FriendlyName                    = "TeeDSP Stream Effect"

FLG_ADDREG_TYPE_MULTI_SZ = 0x00010000
